# Copy to backend/.env and fill in. NEVER commit the real .env.
# MySQL (default profile). Not needed with SPRING_PROFILES_ACTIVE=h2
DB_URL=jdbc:mysql://localhost:3306/vikas_handloom?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# Random string, 32+ chars. Generate: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET=

# First-run admin account. If ADMIN_PASSWORD is empty a random one is printed once in the console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
SEED_DEMO_DATA=true
WATERMARK_TEXT=VIKAS HANDLOOM
# SPRING_PROFILES_ACTIVE=h2   # uncomment for zero-setup local file database